# systemd unit for mfd-bosun (Raspberry Pi or any Linux). install.sh in the Linux release archive
# installs it (see README.md); then:
#   journalctl -u mfd-bosun -f
[Unit]
Description=MFD Bosun: Navico chartplotter screens in a browser, their waypoints, and ForwardScan
After=network-online.target
Wants=network-online.target

[Service]
# options in /etc/default/mfd-bosun: MFD_BOSUN_PASSWORD, MFD_BOSUN_LISTEN, and MFD_BOSUN_ARGS for the rest
EnvironmentFile=-/etc/default/mfd-bosun
ExecStart=/usr/local/bin/mfd-bosun $MFD_BOSUN_ARGS
Restart=always
DynamicUser=yes
# the chartplotters' passwords: /var/lib/mfd-bosun/credentials.json
StateDirectory=mfd-bosun
StateDirectoryMode=0700
# lets it add a 169.254 address for ForwardScan settings changes without running as root
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
